# Required: the _session_id cookie from app.storypark.com (see README "Getting the cookie").
# A full "Cookie:" header value pasted from the browser's Network tab also works.
STORYPARK_SESSION_ID=

# Required: host folder that receives the photos and videos (mounted at /data in the container).
PHOTOS_HOST_PATH=/home/me/storypark

# Optional (defaults shown)
#INTERVAL=6h            # how often to check for new items; 0 = run once and exit
#TZ=Pacific/Auckland    # fallback time zone, used only if a centre does not report one
#CHILD_IDS=             # comma-separated Storypark child IDs to include; default is every child
#CONCURRENCY=4          # parallel downloads
#CENTRE_GPS=            # manual coordinates: <centre id>=<lat>,<lon>;... (overrides geocoding)
#HEALTH_PORT=3000       # host port for the /health endpoint
