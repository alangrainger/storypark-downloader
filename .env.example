# Required: the _session_id cookie from app.storypark.com (see README "Getting the cookie").
# A full "Cookie:" header value pasted from the browser's Network tab also works.
STORYPARK_SESSION_ID=

# Optional (defaults shown)
#INTERVAL=6h            # how often to check for new items; 0 = run once and exit
#TZ=Pacific/Auckland    # fallback time zone, used only if a centre does not report one
#CHILD_IDS=             # comma-separated Storypark child IDs to include; default is every child
#CONCURRENCY=4          # parallel downloads
#CENTRE_GPS=            # manual coordinates: <centre id>=<lat>,<lon>;... (overrides geocoding)
#HEALTH_PORT=3000       # host port for the /health endpoint

# Optional: read centre events out of posts with a local vision model and publish them as an iCal
# feed. Off unless EVENTS_API_URL is set. See the README section "Calendar feed".
#EVENTS_API_URL=http://localhost:11434/v1   # any OpenAI-compatible server (Ollama, LM Studio, vLLM)
#EVENTS_MODEL=qwen3-vl:8b                   # required with the above; the model must accept images
#EVENTS_API_KEY=                            # bearer token, if your model server wants one
#EVENTS_MIN_CONFIDENCE=0.6                  # drop events the model is less sure of than this
#EVENTS_MAX_POST_AGE_DAYS=60                # oldest post worth reading; the feed itself only ever
                                            # holds events from today onwards
#EVENTS_TOKEN=                              # secret path segment: /<token>/events.ics
#EVENTS_IGNORE_CENTRES=                     # centre ids whose posts are not read for events,
                                            # e.g. a centre your child has left
