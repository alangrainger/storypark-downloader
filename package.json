{
  "name": "storypark-downloader",
  "version": "1.0.0",
  "description": "Automatically download your children's photos and videos from Storypark, with dates, location and story links embedded for Immich and other photo libraries",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/alangrainger/storypark-downloader"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node --env-file=.env dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
